# ── 네이버 검색 API (developers.naver.com) ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 유튜브 Data API v3 (Google Cloud Console) ──
YOUTUBE_API_KEY=

# ── Anthropic (Claude) — 감정·요약·대응안 추천 ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_MAIN=claude-sonnet-4-6

# ── Firebase (Admin SDK, 엔진용) ──
# [로컬] 서비스계정 JSON 파일 경로 (Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# [Railway] 위 JSON 파일 내용을 통째로 한 줄에 붙여넣기 (파일 대신 사용)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
FIREBASE_PROJECT_ID=

# ── 임베딩 제공자 ── kosimcse | voyage | openai | tfidf
# tfidf = 의존성 0, 즉시 사용 가능(정확도 낮음). kosimcse = 고정밀(requirements-embed 설치 필요).
EMBED_PROVIDER=tfidf
KOSIMCSE_MODEL=jhgan/ko-sroberta-multitask
VOYAGE_API_KEY=
OPENAI_API_KEY=

# ── 클러스터링 ──
CLUSTER_SIMILARITY_THRESHOLD=0.62
WINDOW_DAYS=30

# ── 스케줄 ──
COLLECT_INTERVAL_MINUTES=30

# ── 스크래핑 (선택) ──
APIFY_API_TOKEN=
HEADLESS=true
